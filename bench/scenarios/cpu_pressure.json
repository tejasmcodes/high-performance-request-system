{
  "name": "cpu_pressure",
  "description": "Artificially increase CPU pressure on backend-3 mid-run",
  "lb_addr": ":18080",
  "backends": [
    { "id": "backend-1", "port": 18081, "weight": 3, "latency_ms": 20 },
    { "id": "backend-2", "port": 18082, "weight": 1, "latency_ms": 20 },
    { "id": "backend-3", "port": 18083, "weight": 2, "latency_ms": 20 }
  ],
  "phases": [
    { "at_s": 30, "action": "set_cpu", "backend": "backend-3", "cpu_workers": 1 }
  ],
  "load": {
    "warmup_s": 5,
    "duration_s": 60,
    "concurrency": 32,
    "rate_per_second": 300
  },
  "strategies": ["round-robin", "least-connections", "weighted-round-robin", "adaptive"],
  "repeats": 5
}
